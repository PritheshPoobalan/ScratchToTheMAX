{
  "ignorePatterns": [
    {
      "pattern": "^https://github.com/PritheshPoobalan/ScratchToTheMAX/(issues|pull|actions|security|wiki)/"
    },
    {
      "pattern": "^https://github.com/PritheshPoobalan/"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^docs/",
      "replacement": "https://github.com/PritheshPoobalan/ScratchToTheMAX/tree/main/docs/"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com/"],
      "headers": {
        "User-Agent": "markdown-link-check"
      }
    }
  ],
  "aliveStatusCodes": [200, 301, 302, 403, 429],
  "retryOn429": true,
  "retryCount": 3,
  "fallbackToHTTP": false
}